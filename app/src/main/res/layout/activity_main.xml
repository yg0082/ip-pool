<?xml version="1.0" encoding="utf-8"?>
<!-- 优选IP集合 v1.1：版面与空间「优选IP集合」一致——顶部两个标签（可换行两行）、卡片式地区组/订阅卡片、大标题+副标题+说明文字。深色面板（GitHub Dark 风格）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0D1117" android:orientation="vertical">

    <!-- 顶部标签栏：两个等宽按钮，中间留空隙；选中=蓝色实底白字，未选中=描边蓝字；文字可换行两行，绝不截断 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="12dp">
        <Button android:id="@+id/btnTabPool" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginEnd="4dp" android:minHeight="60dp"
            android:background="@drawable/bg_button_primary" android:text="聚合优选IP" android:textColor="#FFFFFF"
            android:textSize="16sp" android:textStyle="bold" android:gravity="center"
            android:singleLine="false" android:textAllCaps="false" android:padding="8dp" />
        <Button android:id="@+id/btnTabCf" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="4dp" android:minHeight="60dp"
            android:background="@drawable/bg_tab_inactive" android:text="Cloudflare 优选 IP" android:textColor="#58A6FF"
            android:textSize="16sp" android:textStyle="bold" android:gravity="center"
            android:singleLine="false" android:textAllCaps="false" android:padding="8dp" />
    </LinearLayout>

    <!-- ============ 面板一：聚合优选IP（默认显示） ============ -->
    <androidx.core.widget.NestedScrollView android:id="@+id/panelPool" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">

            <!-- Gist 配置卡片（App 专有，空间里没有；按同样卡片样式放最上面） -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_card" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Gist 配置" android:textSize="16sp" android:textStyle="bold" android:textColor="#E6EDF3" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="把聚合器 Gist 链接粘贴一次存在本机，只用来拉 IP 池和订阅，不会上传，也不会写进 App 里。"
                    android:textColor="#8B949E" android:textSize="13sp" android:layout_marginTop="6dp" />
                <EditText android:id="@+id/inputGistLink" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/bg_input" android:padding="12dp"
                    android:hint="粘贴聚合器 Gist 链接"
                    android:textColor="#E6EDF3" android:textColorHint="#8B949E"
                    android:inputType="text" android:singleLine="true" android:maxLines="1" android:ellipsize="end"
                    android:textSize="13sp" android:layout_marginTop="10dp" />
                <Button android:id="@+id/btnSaveGist" android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_button_primary" android:text="保存" android:textColor="#FFFFFF"
                    android:textSize="14sp" android:textAllCaps="false" android:layout_marginTop="10dp" />
                <TextView android:id="@+id/gistStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="还没配置 Gist 链接" android:textColor="#8B949E" android:textSize="13sp" android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- 聚合订阅卡片 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_card" android:orientation="vertical"
                android:padding="16dp" android:layout_marginTop="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="聚合订阅" android:textSize="18sp" android:textStyle="bold" android:textColor="#E6EDF3" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="聚合器直接生成的节点，没在手机上测过"
                    android:textColor="#8B949E" android:textSize="14sp" android:layout_marginTop="4dp" />
                <TextView android:id="@+id/subEmpty" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="还没配置 Gist 链接" android:textColor="#8B949E" android:textSize="14sp" android:layout_marginTop="12dp" />
                <!-- Clash 行：标签 + 截断链接 + 复制 + 打开 -->
                <LinearLayout android:id="@+id/subClashRow" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="12dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Clash" android:textSize="15sp" android:textStyle="bold" android:textColor="#E6EDF3"
                        android:layout_gravity="center_vertical" />
                    <TextView android:id="@+id/subClashLink" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_gravity="center_vertical"
                        android:textColor="#8B949E" android:textSize="13sp" android:singleLine="true" android:ellipsize="end"
                        android:layout_marginStart="8dp" android:layout_marginEnd="8dp" />
                    <Button android:id="@+id/btnCopyClash" android:layout_width="wrap_content" android:layout_height="40dp"
                        android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:background="@drawable/bg_button_primary" android:text="复制" android:textColor="#FFFFFF"
                        android:textSize="13sp" android:textAllCaps="false" />
                    <Button android:id="@+id/btnOpenClash" android:layout_width="wrap_content" android:layout_height="40dp"
                        android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_outline" android:text="打开" android:textColor="#58A6FF"
                        android:textSize="13sp" android:textAllCaps="false" />
                </LinearLayout>
                <!-- sing-box 行 -->
                <LinearLayout android:id="@+id/subSingboxRow" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="12dp" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="sing-box" android:textSize="15sp" android:textStyle="bold" android:textColor="#E6EDF3"
                        android:layout_gravity="center_vertical" />
                    <TextView android:id="@+id/subSingboxLink" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_gravity="center_vertical"
                        android:textColor="#8B949E" android:textSize="13sp" android:singleLine="true" android:ellipsize="end"
                        android:layout_marginStart="8dp" android:layout_marginEnd="8dp" />
                    <Button android:id="@+id/btnCopySingbox" android:layout_width="wrap_content" android:layout_height="40dp"
                        android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:background="@drawable/bg_button_primary" android:text="复制" android:textColor="#FFFFFF"
                        android:textSize="13sp" android:textAllCaps="false" />
                    <Button android:id="@+id/btnOpenSingbox" android:layout_width="wrap_content" android:layout_height="40dp"
                        android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="14dp" android:paddingEnd="14dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_button_outline" android:text="打开" android:textColor="#58A6FF"
                        android:textSize="13sp" android:textAllCaps="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- 优选 IP 池标题区（不在卡片里，直接放在底色上，和空间一样） -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="优选 IP 池" android:textSize="24sp" android:textStyle="bold" android:textColor="#E6EDF3" />
                <TextView android:id="@+id/poolTitleSub" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_gravity="bottom" android:paddingBottom="3dp"
                    android:text="聚合器收集 · 按地区分开 · 共 0 条" android:textColor="#8B949E" android:textSize="14sp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
            <TextView android:id="@+id/poolCollectInfo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="每 4 小时自动收集一次" android:textColor="#8B949E" android:textSize="14sp" android:layout_marginTop="8dp" />
            <Button android:id="@+id/btnRefreshPool" android:layout_width="wrap_content" android:layout_height="48dp"
                android:minWidth="96dp" android:minHeight="0dp" android:paddingStart="24dp" android:paddingEnd="24dp"
                android:background="@drawable/bg_button_primary" android:text="刷新" android:textColor="#FFFFFF"
                android:textSize="15sp" android:textAllCaps="false" android:layout_marginTop="10dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="聚合器从公开清单里收集的优选 IP，按地区分开，每组只显示条数；点「一键复制」拿到纯 IP（每行一条），拷进「批量测IP」实测就行。"
                android:textColor="#8B949E" android:textSize="14sp" android:lineSpacingExtra="4dp" android:layout_marginTop="10dp" />
            <TextView android:id="@+id/poolStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="还没拉取过 IP 池" android:textColor="#8B949E" android:textSize="13sp" android:layout_marginTop="8dp" />
            <!-- 地区分组由代码动态生成：每个地区一张卡片（地区名 + 条数 / 一键复制全部 N 条 + 下载 .txt），全部组另带 400dp 高的可滚动 IP 显示框 -->
            <LinearLayout android:id="@+id/poolGroups" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="4dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="提示：IP 池每 4 小时由聚合器自动收集更新，点刷新重新拉取；复制或下载后可以拿到批量测IP 里测。订阅里的节点没在手机上测过，先测再用。"
                android:textColor="#8B949E" android:textSize="12sp" android:layout_marginTop="16dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ============ 面板二：Cloudflare 优选 IP（默认隐藏） ============ -->
    <androidx.core.widget.NestedScrollView android:id="@+id/panelCf" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">

            <!-- 标题区（不在卡片里） -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Cloudflare 优选 IP" android:textSize="24sp" android:textStyle="bold" android:textColor="#E6EDF3" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_gravity="bottom" android:paddingBottom="3dp"
                    android:text="待测清单 · 四组独立" android:textColor="#8B949E" android:textSize="14sp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="下面是四组互相独立的清单（200 / 500 / 1000 / 1500）。点某一组的抓取按钮，就从 Cloudflare 官方 IP 段里随机抽取该组数量的不重复 IP，只更新这一组，不影响其他三组；清单不自动更新，只有点按钮才重新抓。每组都有自己的一键复制和下载。清单不分地区：Cloudflare 是任播网络，同一个 IP 在不同网络下走到的机房不一样，快慢只能在你手机上用「批量测IP」实测。"
                android:textColor="#8B949E" android:textSize="14sp" android:lineSpacingExtra="4dp" android:layout_marginTop="10dp" />
            <TextView android:id="@+id/cfSource" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#8B949E" android:textSize="14sp" android:layout_marginTop="10dp" />
            <TextView android:id="@+id/cfStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="还没生成过" android:textColor="#8B949E" android:textSize="13sp" android:layout_marginTop="8dp" />
            <!-- 四组（200 / 500 / 1000 / 1500）由代码动态生成：每组一张卡片（N 个 + 当前 N 个 · 生成于时间 / 抓取 N 个 / 一键复制全部 N 个 IP + 下载 .txt） -->
            <LinearLayout android:id="@+id/cfGroups" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="4dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="提示：这些地址是 Cloudflare 的 CDN 入口，不是节点本身；测的时候用域名握手，裸 IP 直连会被拒。"
                android:textColor="#8B949E" android:textSize="12sp" android:layout_marginTop="16dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
